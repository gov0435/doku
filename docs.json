  "logo": {
    "light": "/logo/panduan-light.png",
    "dark": "/logo/panduan-dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
